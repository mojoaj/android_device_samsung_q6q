<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Galaxy Z Fold6 (q6q). Fold behaviour adapted from q5q; values are a first pass. -->

    <integer name="config_defaultPeakRefreshRate">120</integer>

    <!-- No fixed 120 Hz in the low brightness + low lux zone (sm8650-common sets 120 for
         the S24 panel). Fold6 panels showed no flicker switching 48/96/120 Hz at minimum
         brightness in a dark room (24-b8, refresh_rate_in_zone 0), and the lock kept
         video at 120 Hz in exactly the conditions movies are watched in. -->
    <integer name="config_defaultRefreshRateInZone">0</integer>

    <!-- Inner (main built-in) display: under-display camera, no cutout (as stock). -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false"></string>

    <!-- Cover (secondary built-in) display punch hole. Stock DisplayCutout is 68x88 px
         (+-12.95dp x 33.52dp); widened to 112 px (+-21.33dp) so status bar icons keep
         ~22 px clear of the hole on both sides. Depth kept at 88 px (stock), as it only
         sets the landscape side inset. -->
    <string name="config_secondaryBuiltInDisplayCutout" translatable="false">M 0,0 H -21.333333333333332 V 33.52380952380952 H 21.333333333333332 V 0 H 0 Z @dp</string>
    <string name="config_secondaryBuiltInDisplayCutoutRectApproximation" translatable="false">@string/config_secondaryBuiltInDisplayCutout</string>

    <!-- Physical displays: inner (port 131) and cover (port 132). The per-display arrays
         below are indexed in this order. -->
    <string-array name="config_displayUniqueIdArray" translatable="false">
        <item>"local:4630946165277524611"</item>
        <item>"local:4630947194243491972"</item>
    </string-array>
    <string-array name="config_displayCutoutPathArray" translatable="false">
        <item>@string/config_mainBuiltInDisplayCutout</item>
        <item>@string/config_secondaryBuiltInDisplayCutout</item>
    </string-array>
    <string-array name="config_displayCutoutApproximationRectArray" translatable="false">
        <item>@string/config_mainBuiltInDisplayCutout</item>
        <item>@string/config_secondaryBuiltInDisplayCutoutRectApproximation</item>
    </string-array>

    <!-- Device states come from AOSP BookStyleDeviceStatePolicy, wrapped by
         devicestate/ (Q6qDeviceStatePolicyProvider, system_ext:q6q-devicestate):
         0 CLOSED, 1 HALF_OPENED, 2 OPENED, 3 REAR_DISPLAY, 4 CONCURRENT_INNER_DEFAULT,
         5 REAR_DISPLAY_OUTER_DEFAULT. Tent/wedge mode keeps the cover screen on
         until ~90 degrees when unfolding a little. -->
    <string name="config_deviceSpecificDeviceStatePolicyProvider" translatable="false">org.lineageos.server.policy.Q6qDeviceStatePolicyProvider</string>
    <integer-array name="config_foldedDeviceStates" translatable="false">
        <item>0</item>
    </integer-array>
    <integer-array name="config_halfFoldedDeviceStates" translatable="false">
        <item>1</item>
    </integer-array>
    <integer-array name="config_openDeviceStates" translatable="false">
        <item>2</item>
    </integer-array>
    <integer-array name="config_rearDisplayDeviceStates" translatable="false">
        <item>3</item>
        <item>5</item>
    </integer-array>
    <integer-array name="config_concurrentDisplayDeviceStates" translatable="false">
        <item>4</item>
    </integer-array>
    <integer name="config_deviceStateRearDisplay">3</integer>
    <integer name="config_deviceStateConcurrentRearDisplay">4</integer>
    <string name="config_rearDisplayPhysicalAddress" translatable="false">4630947194243491972</string>

    <!-- Jetpack WindowManager hinge (FoldingFeature) for apps like YouTube flex mode.
         Inner screen is 1856x2160 at rotation 0 with the hinge running top to bottom. -->
    <string name="config_display_features" translatable="false">fold-[928,0,928,2160]</string>
    <!-- DeviceState:Jetpack posture (1 closed, 2 half-opened, 3 opened, 1000 concurrent) -->
    <string-array name="config_device_state_postures" translatable="false">
        <item>0:1</item>
        <item>1:2</item>
        <item>2:3</item>
        <item>3:1</item>
        <item>4:1000</item>
        <item>5:1</item>
    </string-array>
    <!-- Half-folded with the hinge horizontal (rotated 90/270) is tabletop -->
    <integer-array name="config_deviceTabletopRotations" translatable="false">
        <item>90</item>
        <item>270</item>
    </integer-array>
    <integer-array name="config_deviceStatesOnWhichToWakeUp" translatable="false">
        <item>1</item>
        <item>2</item>
    </integer-array>
    <integer-array name="config_deviceStatesOnWhichToSleep" translatable="false">
        <item>0</item>
    </integer-array>
    <!-- The rotation sensor's frame matches the cover screen; seen from the inner
         screen (half-open/open) left and right are swapped. -->
    <integer-array name="config_deviceStatesToReverseDefaultDisplayRotationAroundZAxis" translatable="false">
        <item>1</item>
        <item>2</item>
        <item>4</item>
    </integer-array>
    <string-array name="config_perDeviceStateRotationLockDefaults" translatable="false">
        <!-- posture:value[:fallback] - 0 folded, 1 half-folded, 2 unfolded -->
        <!-- Folded: auto-rotate on. Locked-by-default froze the cover at user_rotation 3 (sideways) after a clean install. -->
        <item>0:2</item>
        <item>1:0:2</item>
        <item>2:2</item>
    </string-array>

    <item name="config_screenBrightnessSettingMinimumFloat" type="dimen">0.0</item>

    <item name="config_screenBrightnessSettingMaximumFloat" type="dimen">1.0</item>

    <!-- ~150 nits (backlight 1000 of 12750) -->
    <item name="config_screenBrightnessSettingDefaultFloat" type="dimen">0.078431375</item>

    <item name="config_screenBrightnessDimFloat" type="dimen">0.015686275</item>


    <!-- Stock: brighten after 1 s, darken after 2 s -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">1000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">2000</integer>

    <!-- Stock keeps a manual adjustment for 10 minutes -->
    <integer name="config_autoBrightnessShortTermModelTimeout">600000</integer>

    <!-- After a fold/unfold the sensor hub needs ~0.5-1 s to bring the other optic up;
         until then it reports stale, too-dark values. Ignore readings for 1 s after the
         light sensor is enabled, keeping the brightness carried over from the other
         screen (needs the frameworks/base warm-up time-base fix). -->
    <integer name="config_lightSensorWarmupTime">1000</integer>

    <bool name="config_allowRotationResolver">false</bool>

    <!-- AOSP unfold animation (inner screen dimmed and scaled, following the hinge) off:
         it kept the inner screen looking dark until ~fully open, 0.6-0.8 s after the panel
         was already on (logs/unfold-1). Stock One UI shows the inner screen at once. -->
    <bool name="config_unfoldTransitionEnabled">false</bool>

    <bool name="config_unfoldTransitionHingeAngle">false</bool>

    <bool name="config_windowManagerPauseRotationWhenUnfolding">true</bool>

    <integer name="config_pauseRotationWhenUnfolding_maxHingeAngle">165</integer>

    <integer name="config_pauseRotationWhenUnfolding_hingeEventTimeout">400</integer>

    <integer name="config_pauseRotationWhenUnfolding_displaySwitchTimeout">1000</integer>

    <bool name="config_systemCaptionsServiceCallsEnabled" translatable="false">true</bool>

    <bool name="config_persistBrightnessNitsForDefaultDisplay">true</bool>

    <bool name="config_supportsConcurrentInternalDisplays">false</bool>

    <bool name="config_fold_lock_behavior">true</bool>

    <!-- The hall sensor ("flip" input device) sends SW_LID when the phone is fully
         closed. sm8650-common sets config_lidControlsSleep for flip covers, which made
         the phone sleep on every close and ignore Settings > Display > "Continue using
         apps on fold". Let the fold setting (config_fold_lock_behavior) decide instead.
         Note: this only seeds Settings.Global.LID_BEHAVIOR on a fresh install. -->
    <bool name="config_lidControlsSleep">false</bool>
    <bool name="config_lidControlsScreenLock">false</bool>

    <!-- Side fingerprint sensor (side key), per display, natural orientation.
         X = right edge. SystemUI (SideFpsSensorInteractor) takes Y as the TOP of the
         sensor and draws the hint over 2 x radius, so Y = measured key centre - radius
         (inner 1020 - 110). Cover tuned on device (b40: hint middle at 1080,
         wanted 1125) to 1020, then
         20 px higher (1000) on 24.0 (24-b11). Hint middle (y from the screen top) =
         Y + ~106 (1000 -> 1106, 1055 -> 1161); user wants the middle at y=1115 -> 1009. Radius ~ half the key length (GUESS). -->
    <array name="config_sfps_sensor_props" translatable="false">
        <item>@array/config_sfps_sensor_props_inner</item>
        <item>@array/config_sfps_sensor_props_cover</item>
    </array>
    <array name="config_sfps_sensor_props_inner" translatable="false">
        <item>local:4630946165277524611</item>
        <item>1856</item>
        <item>910</item>
        <item>110</item>
    </array>
    <array name="config_sfps_sensor_props_cover" translatable="false">
        <item>local:4630947194243491972</item>
        <item>968</item>
        <item>1009</item>
        <item>120</item>
    </array>

    <!-- Inner screen is portrait (707x823dp): split side by side in portrait like One UI
         and AOSP's pixel_fold2 overlay; landscape then splits top/bottom. -->
    <bool name="config_leftRightSplitInPortrait">true</bool>

    <!-- Letterbox portrait-only apps to the display aspect ratio (pixel_fold2). -->
    <bool name="config_letterboxIsDisplayAspectRatioForFixedOrientationLetterboxEnabled">true</bool>

    <!-- Desktop windowing (floating windows) as an opt-in Developer options switch. -->
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>
</resources>

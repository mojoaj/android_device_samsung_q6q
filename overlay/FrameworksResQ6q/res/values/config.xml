<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Galaxy Z Fold6 (q6q). Fold behaviour adapted from q5q; values are a first pass. -->

    <integer name="config_defaultPeakRefreshRate">120</integer>

    <!-- Cover (secondary built-in) display punch hole, from stock DisplayCutout (968x2376, density 2.625) -->
    <string name="config_secondaryBuiltInDisplayCutout" translatable="false">M 0,0 H -12.95238095238095 V 33.52380952380952 H 12.95238095238095 V 0 H 0 Z @dp</string>

    <!-- Physical displays: inner (port 131) and cover (port 132) -->
    <string-array name="config_displayUniqueIdArray" translatable="false">
        <item>"local:4630946165277524611"</item>
        <item>"local:4630947194243491972"</item>
    </string-array>

    <!-- Device states come from configs/device_state_configuration.xml (hinge angle):
         0 = CLOSE, 2 = HALF_OPENED, 3 = OPEN -->
    <integer-array name="config_foldedDeviceStates" translatable="false">
        <item>0</item>
    </integer-array>
    <integer-array name="config_openDeviceStates" translatable="false">
        <item>3</item>
    </integer-array>
    <integer-array name="config_halfFoldedDeviceStates" translatable="false">
        <item>2</item>
    </integer-array>
    <integer-array name="config_rearDisplayDeviceStates" translatable="false">
    </integer-array>
    <integer-array name="config_deviceStatesOnWhichToWakeUp" translatable="false">
        <item>2</item>
        <item>3</item>
    </integer-array>
    <integer-array name="config_deviceStatesOnWhichToSleep" translatable="false">
        <item>0</item>
    </integer-array>
    <!-- The rotation sensor's frame matches the cover screen; seen from the inner
         screen (half-open/open) left and right are swapped. -->
    <integer-array name="config_deviceStatesToReverseDefaultDisplayRotationAroundZAxis" translatable="false">
        <item>2</item>
        <item>3</item>
    </integer-array>
    <string-array name="config_perDeviceStateRotationLockDefaults" translatable="false">
        <!-- posture:value[:fallback] - 0 folded, 1 half-folded, 2 unfolded -->
        <item>0:1</item>
        <item>1:0:2</item>
        <item>2:2</item>
    </string-array>

    <item name="config_screenBrightnessSettingMinimumFloat" type="dimen">0.0</item>

    <item name="config_screenBrightnessSettingMaximumFloat" type="dimen">1.0</item>

    <!-- ~150 nits (backlight 1000 of 12750) -->
    <item name="config_screenBrightnessSettingDefaultFloat" type="dimen">0.078431375</item>

    <item name="config_screenBrightnessDimFloat" type="dimen">0.015686275</item>

    <!-- Lux -> nits curve. Indoors (100-500 lux) stock aims for ~140 nits
         (its config_autoBrightnessLcdBacklightValues via the panel candela map);
         ours is a little brighter. Above 5000 lux uses outdoor HBM. -->
    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>3</item>
        <item>5</item>
        <item>10</item>
        <item>20</item>
        <item>50</item>
        <item>100</item>
        <item>200</item>
        <item>400</item>
        <item>700</item>
        <item>1000</item>
        <item>2000</item>
        <item>3000</item>
        <item>5000</item>
        <item>10000</item>
        <item>20000</item>
        <item>40000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
    </integer-array>

    <integer-array name="config_autoBrightnessDisplayValuesNits">
        <item>5</item>
        <item>8</item>
        <item>12</item>
        <item>18</item>
        <item>30</item>
        <item>55</item>
        <item>110</item>
        <item>150</item>
        <item>190</item>
        <item>240</item>
        <item>290</item>
        <item>360</item>
        <item>430</item>
        <item>500</item>
        <item>800</item>
        <item>1300</item>
        <item>1800</item>
        <item>2400</item>
    </integer-array>

    <!-- React faster than AOSP's 4 s / 8 s -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">2000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">4000</integer>

    <!-- After a fold/unfold the sensor hub needs ~0.5-1 s to bring the other optic up;
         until then it reports stale, too-dark values. Ignore readings for 1 s after the
         light sensor is enabled, keeping the brightness carried over from the other
         screen (needs the frameworks/base warm-up time-base fix). -->
    <integer name="config_lightSensorWarmupTime">1000</integer>

    <bool name="config_allowRotationResolver">false</bool>

    <bool name="config_unfoldTransitionEnabled">true</bool>

    <bool name="config_unfoldTransitionHingeAngle">true</bool>

    <bool name="config_windowManagerPauseRotationWhenUnfolding">true</bool>

    <integer name="config_pauseRotationWhenUnfolding_maxHingeAngle">165</integer>

    <integer name="config_pauseRotationWhenUnfolding_hingeEventTimeout">400</integer>

    <integer name="config_pauseRotationWhenUnfolding_displaySwitchTimeout">1000</integer>

    <bool name="config_systemCaptionsServiceCallsEnabled" translatable="false">true</bool>

    <bool name="config_persistBrightnessNitsForDefaultDisplay">true</bool>

    <bool name="config_supportsConcurrentInternalDisplays">false</bool>

    <bool name="config_fold_lock_behavior">true</bool>

</resources>

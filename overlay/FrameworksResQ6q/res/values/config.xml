        <item>2000</item>
        <item>3000</item>
        <item>5000</item>
        <item>10000</item>
        <item>20000</item>
        <item>40000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
    </integer-array>

    <integer-array name="config_autoBrightnessDisplayValuesNits">
        <item>5</item>
        <item>8</item>
        <item>12</item>
        <item>18</item>
        <item>30</item>

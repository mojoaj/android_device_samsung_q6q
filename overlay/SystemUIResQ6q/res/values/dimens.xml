<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Status bar side padding. Must equal the privacy dot minimum (20dp): SystemUI uses
         max(dot, this) on one side and this on the other, and the cover's centred punch
         hole spacer sits between two equal-weight halves, so unequal sides push the
         end-side icons into the hole. -->
    <dimen name="rounded_corner_content_padding">20dp</dimen>

    <!-- Height of the status bar header bar when on Keyguard -->
    <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height</dimen>

    <!-- Location on the screen of the center of the physical power button. -->
    <!-- Cover screen: side key centre measured at y=1095 px (inner screen: values-sw600dp) -->
    <dimen name="physical_power_button_center_screen_location_y">1095.0px</dimen>

    <!-- Location on the screen of the center of the fingerprint sensor. -->
    <dimen name="physical_fingerprint_sensor_center_screen_location_x">968.0px</dimen>
    <dimen name="physical_fingerprint_sensor_center_screen_location_y">1095.0px</dimen>

    <!-- Pixel pitch of the device. um/px -->
    <item name="pixel_pitch" format="float" type="dimen">50.69</item>

</resources>

#
# Recovery: follow the fold like the OS does. minui switches between the inner
# (DSI-1) and cover (DSI-2) panels on SW_LID from the "flip" hall switch, which
# only toggles once this unit's factory thresholds are loaded (see
# init.q6q.dhall.sh). sec_efs is mounted read-only with noload, so the journal
# is never replayed and nothing is written to it.

on init
    # Touches from this digitiser only drive the cover panel (DRM_SEC).
    setprop ro.minui.second_touch_device sec_touchscreen2
    setprop ro.minui.second_rotation ROTATION_NONE
    write /sys/class/backlight/panel1-backlight/brightness 200

# The init builtins (wait/mount/copy) never mounted sec_efs here on 24-b23
# (no EXT4 sda9 line, threshold stayed 0,0,20000,2000), so the load runs as one
# shell step in recovery's own context, before "on boot" starts recovery, and
# logs the result to kmsg. ($$ = literal $ for init.)
on early-boot
    exec u:r:recovery:s0 root root -- /system/bin/sh -c "D=/mnt/dhall_efs; T=/sys/class/sec/digital_hall/digital_hall_thd; mkdir -p $$D && mount -t ext4 -o ro,nosuid,nodev,noexec,noload /dev/block/bootdevice/by-name/sec_efs $$D && cat $$D/FactoryApp/digital_hall > $$T; r=$$?; umount $$D; rmdir $$D; echo q6q-dhall: ret=$$r thd=$$(cat $$T) > /dev/kmsg"

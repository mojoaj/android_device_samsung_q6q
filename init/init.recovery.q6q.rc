# SPDX-License-Identifier: Apache-2.0
#
# Recovery: follow the fold like the OS does. minui switches between the inner
# (DSI-1) and cover (DSI-2) panels on SW_LID from the "flip" hall switch, which
# only toggles once this unit's factory thresholds are loaded (see
# init.q6q.dhall.sh). sec_efs is mounted read-only with noload, so the journal
# is never replayed and nothing is written to it.

on init
    # Touches from this digitiser only drive the cover panel (DRM_SEC).
    setprop ro.minui.second_touch_device sec_touchscreen2
    setprop ro.minui.second_rotation ROTATION_NONE
    # Cover at 50% like the inner panel gets from recovery (6375 of 12750; 200 was ~1.6%).
    write /sys/class/backlight/panel1-backlight/brightness 6375
    # TEMP (user, 2026-11-15): ADB on without the menu while recovery is being debugged.
    # Same as recovery's Enable ADB item. Remove before release.
    setprop ro.adb.secure.recovery 0

# Load this unit's hall thresholds before "on boot" starts recovery, which reads
# SW_LID once at start (booting folded must open on the cover). sec_efs is
# mounted read-only with noload: the journal is never replayed, nothing is written.
# Not init's copy builtin: it refuses the file ("Skipping insecure file": owned by
# system, group-writable). The shell command has no "$": init expands exec
# arguments twice, so even "$$" breaks. Result in /dev/q6q-dhall.log.
on early-boot
    exec u:r:recovery:s0 root root -- /system/bin/sh -c "mkdir -p /mnt/dhall_efs && mount -t ext4 -o ro,nosuid,nodev,noexec,noload /dev/block/bootdevice/by-name/sec_efs /mnt/dhall_efs && cat /mnt/dhall_efs/FactoryApp/digital_hall > /sys/class/sec/digital_hall/digital_hall_thd && echo loaded >> /dev/q6q-dhall.log || echo failed >> /dev/q6q-dhall.log; cat /sys/class/sec/digital_hall/digital_hall_thd >> /dev/q6q-dhall.log; umount /mnt/dhall_efs; rmdir /mnt/dhall_efs"


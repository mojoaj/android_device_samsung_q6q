# Samsung sensor factory daemon: feeds panel state/brightness and
# calibration to the under-display light/proximity sensors on the ADSP.
# (Its /dev/adsprpc-smd probes stay denied: QC neverallow.)
allow factory_ssc { vendor_sysfs_display vendor_sysfs_graphics }:dir r_dir_perms;
allow factory_ssc { vendor_sysfs_display vendor_sysfs_graphics }:file rw_file_perms;
allow factory_ssc { vendor_sysfs_display vendor_sysfs_graphics }:lnk_file read;
hwbinder_use(factory_ssc)

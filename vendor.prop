# Fingerprint (side-mounted, in the power key)
# GUESS: sensor_location (x|y|radius|display) to be tuned on device
ro.vendor.fingerprint.type=side
ro.vendor.fingerprint.sensor_location=1856|910|110|local:4630946165277524611;968|1020|120|local:4630947194243491972

# Radio
ro.radio.noril=no

# Display: inner panel is mounted rotated (same as stock F956B)
ro.surface_flinger.primary_display_orientation=ORIENTATION_270
debug.sf.ignore_hwc_physical_display_orientation=true

# Camera: hide Samsung's extra camera IDs (20+: inner under-display camera, lens modes)
# from apps, like One UI (stock exposes 0-3). Snapchat otherwise picks ID 71, the inner
# under-display camera, even when folded.
vendor.camera.aux.idlimit=4
vendor.camera.aux.packagelist=org.lineageos.aperture,com.android.cameraextensions,com.google.android.GoogleCamera

# Audio: send display rotation to the audio HAL so the stereo speakers swap L/R at 270 deg
# (left channel follows whichever speaker is on the left). Verified live on cover + inner.
ro.audio.monitorRotation=true

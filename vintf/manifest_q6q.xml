<manifest version="1.0" type="device">
    <!-- q6q: only advertise touch features confirmed on the Fold6 (glove: cmd_list; HTPR: HAL registered it on device).
         The common manifest also declares IHighTouchPollingRate / ITouchscreenGesture; if those
         are declared but not registered, system_server blocks and the watchdog kills it. -->
    <hal format="aidl" override="true">
        <name>vendor.lineage.touch</name>
        <version>1</version>
        <interface>
            <name>IGloveMode</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IHighTouchPollingRate</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>

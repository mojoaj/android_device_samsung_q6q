    <!-- Above 500 nits only with auto-brightness in bright light, like stock. -->
    <highBrightnessMode enabled="true">
        <transitionPoint>0.200000</transitionPoint>
        <minimumLux>3000</minimumLux>
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
    </highBrightnessMode>
    <!-- Auto-brightness: stock lux -> nits curve (logs/stock-BYGB/FINDINGS.md), as
         brightness 0..1. Same mechanism as the inner display, whose map is scaled
         for its weaker sensor. Generated by tools/gen-lux-maps.py. -->
    <autoBrightness enabled="true">
        <luxToBrightnessMapping>
            <map>
                <point><first>0</first><second>0.009961</second></point>
                <point><first>1</first><second>0.012784</second></point>
                <point><first>2</first><second>0.017436</second></point>

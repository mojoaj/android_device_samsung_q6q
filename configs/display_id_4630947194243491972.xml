     Cover panel (S6E3FAE, port 132). Without a file of its own this display
     gets the framework's static 60 Hz defaults once it becomes the default
     display (folded). Values not set here fall back to config.xml.
-->
<displayConfiguration>
    <!-- From Samsung's kernel source (panel_data_file/Q6_S6E3FAE_AMB625GR01.dat, NORMAL and HBM
         candela maps): backlight 0..12750 = brightness 0..1; 2550 = 500 nits is
         the normal maximum, above that is outdoor HBM up to 2500 nits. -->
    <screenBrightnessMap>
        <point>
            <value>0.000000</value>
            <nits>1</nits>
        </point>
        <point>
            <value>0.002353</value>
            <nits>2</nits>
        </point>
        <point>
            <value>0.004706</value>
            <nits>5</nits>
        </point>
        <point>
            <value>0.007843</value>
            <nits>8</nits>
        </point>
        <point>
            <value>0.015608</value>
            <nits>19</nits>
        </point>
        <point>
            <value>0.023529</value>
            <nits>32</nits>
        </point>
        <point>
            <value>0.039216</value>
            <nits>61</nits>
        </point>
        <point>
            <value>0.054902</value>
            <nits>94</nits>
        </point>
        <point>
            <value>0.078431</value>
            <nits>149</nits>
        </point>
        <point>
            <value>0.101882</value>
            <nits>209</nits>
        </point>
        <point>
            <value>0.125490</value>
            <nits>273</nits>
        </point>
        <point>
            <value>0.156784</value>
            <nits>365</nits>
        </point>
        <point>
            <value>0.180392</value>
            <nits>437</nits>
        </point>
        <point>
            <value>0.200000</value>
            <nits>500</nits>
        </point>
        <point>
            <value>0.313725</value>
            <nits>785</nits>
        </point>
        <point>
            <value>0.470588</value>
            <nits>1177</nits>
        </point>
        <point>
            <value>0.627451</value>
            <nits>1569</nits>
        </point>
        <point>
            <value>0.784314</value>
            <nits>1961</nits>
        </point>
        <point>
            <value>1.000000</value>
            <nits>2500</nits>
        </point>
    </screenBrightnessMap>
    <!-- Above 500 nits only with auto-brightness in bright light, like stock. -->
    <highBrightnessMode enabled="true">
        <transitionPoint>0.200000</transitionPoint>
        <minimumLux>5000</minimumLux>
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
    </highBrightnessMode>
    <autoBrightness enabled="true" />
    <refreshRate>
        <defaultRefreshRate>0</defaultRefreshRate>
        <defaultPeakRefreshRate>120</defaultPeakRefreshRate>
    </refreshRate>
    <!-- Under-display IR proximity by the cover panel (also fed by the
         cover touchscreen's ear detection on the ADSP). -->
    <proxSensor>
        <type>android.sensor.proximity</type>
        <name>IR Proximity virtual_prox Sensor Wakeup</name>
    </proxSensor>
</displayConfiguration>

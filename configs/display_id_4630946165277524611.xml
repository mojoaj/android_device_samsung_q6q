     Inner panel (S6E3XA5, port 131). Uses touchscreen proximity
     (see below) and sets 120 Hz. Values not set here fall back to
     config.xml.
-->
<displayConfiguration>
    <refreshRate>
        <defaultRefreshRate>0</defaultRefreshRate>
        <defaultPeakRefreshRate>120</defaultPeakRefreshRate>
    </refreshRate>
    <!-- Both real proximity sensors (virtual_prox, tmd4914_sub) face the cover
         side, i.e. the back when unfolded (b17 test), so they would blank the
         inner screen from the back. With no sensor at all (b18) the dialer
         sees "no proximity wake lock" when a call starts unfolded and then
         never uses proximity, even after folding.
         GUESS: Samsung's touchscreen proximity keeps proximity "available"
         without reacting to the back. -->
    <proxSensor>
        <type>com.samsung.sensor.touch_proximity</type>
        <name>Touch Proximity Sensor</name>
    </proxSensor>
</displayConfiguration>

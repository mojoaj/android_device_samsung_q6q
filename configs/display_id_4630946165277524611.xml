                <brightnessThresholdPoint><threshold>1000</threshold><percentage>100</percentage></brightnessThresholdPoint>
                <brightnessThresholdPoint><threshold>2000</threshold><percentage>50</percentage></brightnessThresholdPoint>
                <brightnessThresholdPoint><threshold>3000</threshold><percentage>33</percentage></brightnessThresholdPoint>
                <brightnessThresholdPoint><threshold>4000</threshold><percentage>25</percentage></brightnessThresholdPoint>
                <brightnessThresholdPoint><threshold>5000</threshold><percentage>20</percentage></brightnessThresholdPoint>

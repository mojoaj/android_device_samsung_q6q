     SPDX-License-Identifier: Apache-2.0

     Inner panel (S6E3XA5, port 131). Disables the proximity sensor
     (see below) and sets 120 Hz. Values not set here fall back to
     config.xml.
-->
<displayConfiguration>
    <refreshRate>
        <defaultRefreshRate>0</defaultRefreshRate>
        <defaultPeakRefreshRate>120</defaultPeakRefreshRate>
    </refreshRate>
    <!-- No proximity sensor for the inner panel. Both proximity sensors
         (virtual_prox and tmd4914_sub) face the cover side, i.e. the back of
         the phone when unfolded (tested b17: covering the inner top edge
         gave no events, covering the back did). Empty values = no sensor. -->
    <proxSensor>
        <type></type>
        <name></name>
    </proxSensor>
</displayConfiguration>

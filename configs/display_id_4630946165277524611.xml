    <!-- Above 500 nits only with auto-brightness in bright light, like stock. -->
    <highBrightnessMode enabled="true">
        <transitionPoint>0.200000</transitionPoint>
        <minimumLux>3000</minimumLux>
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
    </highBrightnessMode>
    <!-- Auto-brightness: stock lux -> nits curve, at scaled lux points. The inner
         (under-display) light sensor reads ~0.4-0.5x the cover one in dim light
         (logs/brightness-tune), so 0.5x below 10 lux, blending to 1:1 at 50 lux.
         Generated by tools/gen-lux-maps.py (second = brightness 0..1). -->
    <autoBrightness enabled="true">
        <luxToBrightnessMapping>
            <map>
                <point><first>0</first><second>0.009961</second></point>
                <point><first>0.51</first><second>0.012784</second></point>
                <point><first>1.02</first><second>0.017588</second></point>
                <point><first>1.54</first><second>0.020229</second></point>
                <point><first>2.08</first><second>0.023529</second></point>
                <point><first>2.62</first><second>0.025621</second></point>
                <point><first>5.5</first><second>0.031372</second></point>
                <point><first>9.3</first><second>0.039706</second></point>
                <point><first>14.4</first><second>0.048039</second></point>
                <point><first>20</first><second>0.052451</second></point>
                <point><first>50</first><second>0.054902</second></point>
                <point><first>100</first><second>0.057469</second></point>
                <point><first>300</first><second>0.062602</second></point>
                <point><first>500</first><second>0.070731</second></point>
                <point><first>1000</first><second>0.098755</second></point>
                <point><first>2000</first><second>0.168426</second></point>
                <point><first>3000</first><second>0.239904</second></point>
                <point><first>4000</first><second>0.319727</second></point>
                <point><first>5000</first><second>0.399760</second></point>
                <point><first>6000</first><second>0.479792</second></point>
                <point><first>7000</first><second>0.559824</second></point>
                <point><first>8000</first><second>0.639856</second></point>
                <point><first>9000</first><second>0.719888</second></point>
                <point><first>10000</first><second>0.799920</second></point>
                <point><first>12000</first><second>1.000000</second></point>
            </map>
        </luxToBrightnessMapping>
    </autoBrightness>
    <refreshRate>
        <defaultRefreshRate>0</defaultRefreshRate>
        <defaultPeakRefreshRate>120</defaultPeakRefreshRate>
    </refreshRate>
    <!-- No proximity sensor: both real ones (virtual_prox, tmd4914_sub) face the
         cover side, i.e. the back when unfolded (b17 test). Touch Proximity (b19)
         is the cover touchscreen's ear detect, reports 0 for "far" and blanked
         the inner screen at random. Empty values = no sensor; the framework
         still reports proximity wake lock support (local patch). -->
    <proxSensor>
        <type></type>
        <name></name>
    </proxSensor>
    <!-- Lux hysteresis from stock BYGB (SecHysteresisLevels, logs/stock-BYGB/dumpsys-display.txt).
         Stock gives absolute lux targets (e.g. at 100 lux: brighten above 400, darken below 40);
         here they are percentages of the current lux at each stock point. -->
    <ambientBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>10</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint><threshold>0</threshold><percentage>700</percentage></brightnessThresholdPoint>
                <brightnessThresholdPoint><threshold>15</threshold><percentage>700</percentage></brightnessThresholdPoint>

                <brightnessThresholdPoint><threshold>20000</threshold><percentage>150</percentage></brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </brighteningThresholds>
        <darkeningThresholds>
            <minimum>0</minimum>
            <brightnessThresholdPoints>

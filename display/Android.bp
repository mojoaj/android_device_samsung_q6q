// Display policy for the Galaxy Z Fold6: refresh-rate default and panel LFD rules.
android_app {
    name: "Q6qDisplayPolicy",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
}
